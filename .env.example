# PictoMusic Environment Configuration
# Copy this file to .env and adjust values as needed.

# --- Model ---
# PICTOMUSIC_CLIP_MODEL=openai/clip-vit-base-patch32
# For better accuracy (requires more RAM): openai/clip-vit-large-patch14
# PICTOMUSIC_BATCH_SIZE=32
# PICTOMUSIC_MAX_TOKEN_LEN=77

# --- Recommendation ---
# PICTOMUSIC_TOP_K=10
# PICTOMUSIC_MOOD_BOOST=0.1

# --- File paths (override only if needed) ---
# PICTOMUSIC_DATASET_PATH=
# PICTOMUSIC_EMBEDDINGS_PATH=

# --- Security ---
# PICTOMUSIC_MAX_UPLOAD_MB=10
# PICTOMUSIC_REQUEST_TIMEOUT=10
# PICTOMUSIC_MAX_URL_LEN=2048
# PICTOMUSIC_RATE_LIMIT_MAX=10
# PICTOMUSIC_RATE_LIMIT_WINDOW=60
# PICTOMUSIC_MAX_IMAGE_PIXELS=25000000

# --- India-First Retrieval & Recommendation Weights ---
# PICTOMUSIC_RETRIEVAL_CANDIDATE_MULT=30
# PICTOMUSIC_RECENT_YEAR=2025
# PICTOMUSIC_INDIA_WEIGHT=0.22
# PICTOMUSIC_LANGUAGE_WEIGHT=0.22
# PICTOMUSIC_REGION_WEIGHT=0.14
# PICTOMUSIC_FRESHNESS_WEIGHT=0.08
# PICTOMUSIC_POPULARITY_WEIGHT=0.06
# PICTOMUSIC_PREVIEW_WEIGHT=0.08
# PICTOMUSIC_ARTWORK_WEIGHT=0.015
# PICTOMUSIC_PREVIEW_TARGET_SHARE=0.6
# PICTOMUSIC_PREVIEW_IMPORTANCE_MARGIN=0.12
# PICTOMUSIC_MOOD_SIM_THRESHOLD=0.15
# PICTOMUSIC_MOOD_TOP_N=2
# PICTOMUSIC_MOOD_FETCH_MULT=3

